APP_NAME=Wedding RSVP API
APP_ENV=development
DEBUG=false

HOST=127.0.0.1
PORT=8000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=wedding_rsvp_development
DATABASE_USER=wedding_dev
DATABASE_PASSWORD=REPLACE_WITH_STRONG_DEVELOPMENT_PASSWORD
DATABASE_URL=mysql+pymysql://wedding_dev:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/wedding_rsvp_development

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_DEVELOPMENT_SECRET
REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_DEVELOPMENT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGINS=http://localhost:5173

RSVP_RATE_LIMIT=10/minute
GUEST_VERIFY_RATE_LIMIT=10/minute
ADMIN_LOGIN_RATE_LIMIT=5/minute
ADMIN_MAX_FAILED_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

LOG_LEVEL=INFO
LOG_DIRECTORY=C:/Projects/wedding-rsvp/logs/development
UPLOAD_DIRECTORY=C:/Projects/wedding-rsvp/uploads/development
